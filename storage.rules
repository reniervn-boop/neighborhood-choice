rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Newsletter PDFs — any signed-in user can read; only signed-in can write
    // (committee-only access enforced at the app/UI level)
    match /newsletters/{newsletterId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024  // 20 MB max
                   && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null;
    }

    // Halloween / general uploads — keep existing behaviour
    match /halloween-uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reports / civic uploads
    match /reports/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Announcement attachments (JPG, PNG, PDF)
    // Type + size enforced client-side; allow any authenticated write here
    match /announcements/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
